[Unit]
Description=Tablet first-boot setup (roles from /etc/tablet-roles)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/tablet/done/all

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tablet-firstboot
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
